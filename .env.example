# =====================================================================
# PixelBin Claude Skill — credentials
# Copy this file to `.env` and fill in your values. Never commit `.env`.
# =====================================================================

# Required: your PixelBin API token (Owner / Admin only)
# Get it from: console.pixelbin.io → Settings → Tokens → API Token
PIXELBIN_API_TOKEN=

# Required: your PixelBin organization cloud name (immutable slug)
# Find it at: console.pixelbin.io → Settings → Organization
# Example: round-dust-e06b92
PIXELBIN_CLOUD_NAME=

# Optional: default folder for uploads (defaults to "claude-skill")
# PIXELBIN_FOLDER=claude-skill

# Optional: default image-generation model when not specified
#   nanoBanana_generate     — fastest / cheapest, good for edits
#   nanoBanana2_generate    — default, high quality (recommended)
#   nanoBananaPro_generate  — hero / showcase quality
# PIXELBIN_IMAGE_MODEL=nanoBanana2_generate

# Optional: default video-generation model
#   veo3_generate, veo3Fast_generate, sora2_generate,
#   kling3_generate, kling26_generate, hailuo23_generate,
#   seedancePro_generate, wan25_generate, ltx2_generate
# PIXELBIN_VIDEO_MODEL=veo3Fast_generate

# Don't have an account? Sign up free:
# https://www.pixelbin.io/?utm_source=github&utm_medium=claude-skill&utm_campaign=signup
